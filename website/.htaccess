DirectoryIndex index.html index.php
Options -Indexes

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml font/woff2
</IfModule>

# Browser caching
# CSS/JS/images stay short while the site is under active edit so a deploy
# is never masked by a client's stale cache (this bit us once already).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 5 minutes"
  ExpiresByType text/css               "access plus 5 minutes"
  ExpiresByType application/javascript "access plus 5 minutes"
  ExpiresByType image/svg+xml          "access plus 1 day"
  ExpiresByType image/jpeg             "access plus 1 day"
  ExpiresByType image/png              "access plus 1 day"
  ExpiresByType image/webp             "access plus 1 day"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType text/plain             "access plus 5 minutes"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
